{
  "name": "afilmory",
  "main": "./.worker-build/index.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photo-views",
      "database_id": "4ae9be5a-91fc-4023-b8d6-c5304a10278a"
    }
  ]
}
